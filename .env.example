# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

# Flask session/CSRF signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Defaults to a local SQLite file under instance/ if unset.
DATABASE_URL=sqlite:///agrovision.db

# Google Gemini API Key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Fallback Groq API Key — https://console.groq.com/keys
GROQ_API_KEY=

# Nepal Market Price API (optional)
MARKET_PRICE_API_KEY=
PORT=5001
